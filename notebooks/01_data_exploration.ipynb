#Explore Genomic Data
# Genomic pathway scores
pathway_scores = data['genomic']
plt.figure(figsize=(12, 8))
plt.imshow(pathway_scores[:50, :], aspect='auto', cmap='RdBu_r')
plt.colorbar(label='Pathway Score')
plt.xlabel('Pathway')
plt.ylabel('Patient')
plt.title('GSVA Pathway Scores (First 50 Patients)')
plt.show()


#Survival Analysis
from lifelines import KaplanMeierFitter

# Overall survival
kmf = KaplanMeierFitter()
kmf.fit(data['survival_time'], data['survival_event'])

plt.figure(figsize=(10, 6))
kmf.plot_survival_function()
plt.title('Overall Survival')
plt.xlabel('Time (months)')
plt.ylabel('Survival Probability')
plt.show()



