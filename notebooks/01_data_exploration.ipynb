# Data Exploration Notebook

## Setup

```python
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from pathlib import Path

# Add project root to path
import sys
sys.path.append('..')

from data_loader import NSCLCDataLoader
from utils.preprocessing import ImagePreprocessor, ClinicalPreprocessor, GenomicPreprocessor

# Load Data 
# Initialize data loader
loader = NSCLCDataLoader(data_dir='../data/tcia', split_by_year=True)

# Load data
data = loader.load_data(data_type='tcia')

# Print data shapes
for key, value in data.items():
    if isinstance(value, np.ndarray):
        print(f"{key}: {value.shape}")
    elif isinstance(value, pd.DataFrame):
        print(f"{key}: {value.shape}")
    else:
        print(f"{key}: {type(value)}")


#Explore Feature Distributions

# CT features
fig, axes = plt.subplots(2, 4, figsize=(16, 8))
for i, col in enumerate(['mean', 'std', 'skewness', 'kurtosis', 'contrast', 'correlation', 'energy', 'homogeneity']):
    ax = axes[i // 4, i % 4]
    ax.hist(data['ct'][:, i], bins=30, alpha=0.7)
    ax.set_title(f'CT: {col}')
    ax.set_xlabel('Value')
    ax.set_ylabel('Frequency')
plt.tight_layout()
plt.show()

# Explore Clinical Data
clinical_df = data['clinical']
print(clinical_df.head())

# Stage distribution
plt.figure(figsize=(10, 6))
clinical_df['stage'].value_counts().sort_index().plot(kind='bar')
plt.title('Stage Distribution')
plt.xlabel('Stage')
plt.ylabel('Count')
plt.show()

# Survival by stage
plt.figure(figsize=(10, 6))
for stage in sorted(clinical_df['stage'].unique()):
    mask = clinical_df['stage'] == stage
    plt.hist(data['survival_time'][mask], bins=20, alpha=0.5, label=f'Stage {stage}')
plt.xlabel('Survival Time (months)')
plt.ylabel('Count')
plt.legend()
plt.show()

